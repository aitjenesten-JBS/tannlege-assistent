# Kopier til .env.local og fyll inn. Aldri commit ekte nøkler.
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bekreftelsesmail (valgfritt). I demoen sendes e-post bare når adressen i skjemaet er lik
# EPOST_DEMO_MOTTAKER. Alle andre får forhåndsvisning i chatten.
RESEND_API_KEY=
EPOST_DEMO_MOTTAKER=
EPOST_AVSENDER=

# Tilgang til /admin i produksjon: /admin?nokkel=...
ADMIN_NOKKEL=
